# WideAngle environment configuration
#
# Copy to `.env.local` for development:
#   cp .env.example .env.local
#
# Server-side only. NONE of these variables are exposed to the browser
# bundle — the adapter and the config module are server-only, and no
# `NEXT_PUBLIC_` prefix is used anywhere in this project.

# ---------------------------------------------------------------------------
# Publication identity (required)
# ---------------------------------------------------------------------------

# The single public origin for this publication. No trailing slash, no path.
# Used to build every canonical URL, sitemap entry and feed item.
# In production this MUST NOT be localhost — the app refuses to boot if it is.
WIDEANGLE_CANONICAL_ORIGIN=https://wideangle.example.com

# Human-readable publication name.
WIDEANGLE_PUBLICATION_NAME=WideAngle

# One-sentence description of the publication.
WIDEANGLE_PUBLICATION_DESCRIPTION=A single-author publication about building and operating content infrastructure.

# Locale for <html lang> and the feed.
WIDEANGLE_LOCALE=en

# ---------------------------------------------------------------------------
# Calliope connection (required)
# ---------------------------------------------------------------------------

# Base URL of the Calliope content service.
WIDEANGLE_CALLIOPE_BASE_URL=http://localhost:3002

# The blog (publication) UUID to read from.
WIDEANGLE_CALLIOPE_BLOG_ID=7604f178-68f6-4e65-9d79-de091b1ead15

# ---------------------------------------------------------------------------
# Freshness (optional)
# ---------------------------------------------------------------------------

# Maximum staleness, in seconds, between a Calliope change and this
# site reflecting it. Default 300 (5 minutes). This is the withdrawal
# window: an article withdrawn in Calliope disappears here within this
# window (AC-09).
WIDEANGLE_CONTENT_REVALIDATE_SECONDS=300

# Per-request timeout for Calliope calls, in milliseconds. A timeout
# renders a temporary error, never a permanent 404 (AC-08).
WIDEANGLE_CALLIOPE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Future multi-publication support (optional, off by default)
# ---------------------------------------------------------------------------

# The publication UUID. Only meaningful when the upstream supports
# publication-scoped reads.
WIDEANGLE_PUBLICATION_ID=

# Set to true ONLY when Calliope actually supports publication-scoped
# reads. While this is false the adapter sends no scope parameter, so
# the site cannot silently appear to support a contract it does not.
WIDEANGLE_CALLIOPE_SUPPORTS_PUBLICATION_SCOPE=false

# ---------------------------------------------------------------------------
# Contact + images (optional)
# ---------------------------------------------------------------------------

# Address shown on /contact and in the footer.
WIDEANGLE_CONTACT_EMAIL=hello@example.com

# Comma-separated hostnames permitted to serve article imagery.
# Empty means article images are not optimized through next/image.
WIDEANGLE_IMAGE_HOSTS=
